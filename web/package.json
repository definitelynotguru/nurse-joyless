{
  "name": "nurse-joyless",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "Competitive Pokemon Showdown team clinic: structure analysis, matchup diagnosis, KO risk, replay evidence, and hidden-information reasoning.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
